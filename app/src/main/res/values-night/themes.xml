<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for night mode using Material 3 -->
    <style name="Theme.RateBook" parent="Theme.Material3.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue_200</item>
        <item name="colorPrimaryContainer">@color/blue_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorOnPrimaryContainer">@color/blue_100</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/blue_200</item>
        <item name="colorSecondaryContainer">@color/blue_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorOnSecondaryContainer">@color/blue_100</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/blue_900</item>
        <!-- Surface colors for dark mode -->
        <item name="colorSurface">@color/blue_900</item>
        <item name="colorSurfaceVariant">@color/blue_800</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/blue_200</item>
        <item name="colorOutline">@color/blue_500</item>
        <item name="colorOutlineVariant">@color/blue_700</item>
    </style>

    <style name="Theme.RateBook.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.RateBook.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <style name="Theme.RateBook.PopupOverlay" parent="ThemeOverlay.Material3.Light" />
</resources>
